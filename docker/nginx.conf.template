worker_processes auto;
pid /tmp/janus-nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    access_log /dev/stdout;
    client_body_temp_path /tmp/client-body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    upstream phoenix { server backend:4000; }

    server {
        listen 8443 ssl;
        server_name ${PUBLIC_HOST};
        ssl_certificate ${TLS_CERT_PATH};
        ssl_certificate_key ${TLS_KEY_PATH};
        ssl_protocols TLSv1.2 TLSv1.3;
        root /usr/share/nginx/html;
        client_max_body_size 3m;

        location ^~ /api/internal/ { return 404; }
        location ^~ /ai_socket { return 404; }
        location /api/ {
            proxy_pass http://phoenix;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 120s;
        }
        location /socket {
            proxy_pass http://phoenix;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 75s;
        }
        location = /config.js {
            # Rendered at container start from PUBLIC_ORIGIN; never cached.
            root ${FRONTEND_RUNTIME_DIR};
            add_header Cache-Control 'no-store' always;
        }
        location / { try_files $uri $uri/ =404; }
    }

    # Private TLS callback listener: never publish this port on the host.
    # AI uses the same certificate hostname through the service-network alias.
    server {
        listen 9443 ssl;
        server_name ${PUBLIC_HOST};
        ssl_certificate ${TLS_CERT_PATH};
        ssl_certificate_key ${TLS_KEY_PATH};
        ssl_protocols TLSv1.2 TLSv1.3;
        client_max_body_size 3m;
        # Operations derives this fixed read from PHOENIX_BASE_URL.
        location = /api/health {
            proxy_pass http://phoenix;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
        }
        location /api/internal/ {
            proxy_pass http://phoenix;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 120s;
        }
        location /ai_socket {
            proxy_pass http://phoenix;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 75s;
        }
        location / { return 404; }
    }
}
